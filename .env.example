# API Keys for AI Model Comparison App
# Copy this file to .env and add your actual API keys
# NEVER commit .env to version control!

# OpenAI API Key (for GPT-4, GPT-4o)
VITE_OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (for Claude models)
VITE_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google AI API Key (for Gemini models)
VITE_GOOGLE_API_KEY=your-google-api-key-here

# xAI API Key (for Grok)
VITE_XAI_API_KEY=your-xai-key-here

# DeepSeek API Key
VITE_DEEPSEEK_API_KEY=your-deepseek-key-here

# Mistral API Key
VITE_MISTRAL_API_KEY=your-mistral-key-here

# Perplexity API Key
VITE_PERPLEXITY_API_KEY=your-perplexity-key-here
